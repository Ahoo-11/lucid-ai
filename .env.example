# Copy this file to .env and set ONE AI key. `npm start` reads it.
#
# Lucid uses this AI to diagnose your agents' problems, group them by cause,
# rate them, write the fix, and run the Arena. Without a key, runs are still
# captured and shown, but the Inbox can't explain or fix anything.

# Meta's Model API (Muse Spark). Get a key at https://dev.meta.ai/api-keys
# (Meta's docs call it MODEL_API_KEY; either name works.)
META_API_KEY=

# Or OpenRouter: one key for every model, Muse Spark included. https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Or Muse Spark on Baseten. https://app.baseten.co/settings/api_keys
# BASETEN_API_KEY=

# Optional: another model for Lucid's own features.
# Default: muse-spark-1.3 (Meta), meta/muse-spark-1.3 (OpenRouter).
# LUCID_AI_MODEL=

# Optional: the port (default 4318, the standard OpenTelemetry port).
# PORT=4318
